&CONTROL
  calculation = 'scf'
  prefix      = 'si64_k3'
  outdir      = './tmp'
  pseudo_dir  = '../pseudo'
  tprnfor     = .true.     ! print forces
  tstress     = .true.     ! print stress
  disk_io     = 'none'     ! we only need the .out file
/
&SYSTEM
  ibrav     = 0
  nat       = 64
  ntyp      = 1
  ecutwfc   = 40
  ecutrho   = 320
  occupations = 'fixed'    ! Si is a semiconductor
  nspin     = 1
/
&ELECTRONS
  conv_thr  = 1.0d-10
  mixing_beta = 0.5
  electron_maxstep = 200
/
