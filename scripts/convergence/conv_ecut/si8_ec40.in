&CONTROL
  calculation = 'scf'
  prefix      = 'si8_ec40'
  outdir      = './tmp'
  pseudo_dir  = '../pseudo'
  tprnfor     = .true.     ! print forces
  tstress     = .true.     ! print stress
  disk_io     = 'none'     ! we only need the .out file
/
&SYSTEM
  ibrav     = 0
  nat       = 8
  ntyp      = 1
  ecutwfc   = 40
  ecutrho   = 320
  occupations = 'fixed'    ! Si is a semiconductor
  nspin     = 1
/
&ELECTRONS
  conv_thr  = 1.0d-10
  mixing_beta = 0.5
  electron_maxstep = 200
/
ATOMIC_SPECIES
  Si 28.0855 Si.us.pbesol.z_4.ld1.psl.v1.0.0-high.upf
K_POINTS automatic
  4 4 4 0 0 0
CELL_PARAMETERS angstrom
  5.4690000000 0.0000000000 0.0000000000
  0.0000000000 5.4690000000 0.0000000000
  0.0000000000 0.0000000000 5.4690000000
